  (text "Reads one separate temperature probe for each battery pack. Each resistor network turns the\nprobe resistance into a voltage. Two further inputs receive the protected-rail readings from f06a.\nCroi supplies monitoring power and reads all four channels over the f03 I2C connection."
    (at 15.24 22.86 0)
    (effects
      (font
        (size 1.4 1.4))
      (justify left top))
    (uuid "8c962fd2-5652-405a-80ac-b405a0c89e32")))
