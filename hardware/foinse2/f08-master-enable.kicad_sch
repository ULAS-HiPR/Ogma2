  (text "EXTERNAL ON/OFF SWITCH / two separate low-current contact loops"
    (at 15.24 15.24 0.0)
    (effects
      (font
        (size 2.0 2.0))
      (justify left top))
    (uuid "2cbe3a5b-a0e7-40d4-996e-fd61e146ecde"))
  (text "The external switch closes each loop to enable its battery branch: J103 controls f01; J104 controls f02.\nBoth loops carry bounded 3 V control only. Separate switch poles; battery positives NEVER join.\nUnplugged/open contact -> local SHDN pull-down -> electronic OFF. No MCU or AUX dependency."
    (at 15.24 30.48 0.0)
    (effects
      (font
        (size 1.25 1.25))
      (justify left top))
    (uuid "5076c89c-d9ea-4888-ab6c-0539d499aa0e"))
