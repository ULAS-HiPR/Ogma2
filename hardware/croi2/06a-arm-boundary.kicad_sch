  (text "What this does: Senses armed-rail voltage and combines the conditions for the staging channel.\nConnects to: 06-outputs eligibility + flight requests + external arm indications -> channel permissions. The physical arm assembly and its proof contacts are still undefined."
    (at 15.24 27.94 0.0)
    (effects
      (font
        (size 1.4 1.4))
      (justify left top))
    (uuid "1fb11f76-5195-5161-85d7-34862644732f")))
