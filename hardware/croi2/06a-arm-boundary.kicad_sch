	(text "OPEN: the arm switches; F6101 / F6102 breaking capacity against the pack."
		(exclude_from_sim no)
		(at 15.24 342.9 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left)
		)
		(uuid "07f1b813-74c3-52ca-92a1-9aa53b3f804f")
	)
	(text "What this does: Feeds each pyro group from ENERGY_TAP through its own fuse and external arm switch, and senses the armed voltage.\nConnects to: ENERGY_TAP (01-power) -> F6101 / F6102 -> J6101 / J6102 -> RECOVERY_ARMED_VBAT (06pyro1, 06pyro2) and STAGING_ARMED_VBAT (06pyro3); arm sense -> PE13 / PE15."
		(exclude_from_sim no)
		(at 15.24 27.94 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "1fb11f76-5195-5161-85d7-34862644732f")
	)
	(text "ARM FEEDS / ARM SENSE"
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "3921b1ec-e76e-5a32-8c26-10c25498b823")
	)
	(text "EXTERNAL MASTER POWER ENABLE IS NOT ENERGETIC ISOLATION."
		(exclude_from_sim no)
		(at 15.24 332.74 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left)
		)
		(uuid "3c0cb16e-acd2-524d-a0c7-ab4e61f81963")
	)
	(text "F6101 / F6102: Littelfuse 0451004.MRL, 4 A fast-acting NANO2, one per arm feed so a staging short cannot open recovery's fuse (D-2Nov.2).\nA 2 A firing pulse is half the rating and cannot open it; both recovery channels at once are 4 A, at the rating.\nJ6101: Molex Mini-Fit Jr. 39281023 (4.2 mm, 9 A); J6102: JST VH B2P-VH (3.96 mm, 10 A) (D-21Nov.12).\nTwo families: neither takes the other's plug, Churro J701's Micro-Fit, the GH enable loops or J101's Nano-Fit."
		(exclude_from_sim no)
		(at 40.64 137.16 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "4a3daf93-70d0-5139-afd8-c3aeb9dc5b63")
	)
	(text "2  ARMED-RAIL VOLTAGE INDICATION / NOT DISARM PROOF"
		(exclude_from_sim no)
		(at 15.24 160.02 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left)
		)
		(uuid "4aaf6b6c-ebfd-5d40-9d51-cfabec09624d")
	)
	(text "STAGE_ARM_INVALID (U6103 OUTB) -> R6108 -> PE15, read inverted; it is also the staging latch D input on 06-outputs."
		(exclude_from_sim no)
		(at 15.24 347.98 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left)
		)
		(uuid "715c815b-fdac-5a8b-b94e-ebab6ddb8bc4")
	)
	(text "1  ARM FEEDS: FUSED ENERGY_TAP TO EACH EXTERNAL ARM SWITCH"
		(exclude_from_sim no)
		(at 15.24 58.42 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left)
		)
		(uuid "7cd4365d-15bd-5f96-9389-f25639770e94")
	)
	(text "Voltage presence gives an arm indication; it does not qualify the external mechanical assembly."
		(exclude_from_sim no)
		(at 15.24 353.06 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left)
		)
		(uuid "ffe2bee9-25fd-575d-9a27-6f4867193f40")
	)
