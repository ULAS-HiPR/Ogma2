  (text "What this does: Holds the flight MCU in reset when its supply is unsuitable, and gives us a dedicated programming/debug connection.\nConnects to: Flight rail + external watchdog -> supervisor -> U201 reset. Tag-Connect goes to U201 SWD; reset also inhibits output authority."
    (at 15.24 27.94 0.0)
    (effects
      (font
        (size 1.4 1.4))
      (justify left top))
    (uuid "05a30e74-453e-5cc8-adac-c356436ebfe8")))
