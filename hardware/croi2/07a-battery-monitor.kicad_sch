	(text "Kelvin sense lines leave the shunt pads independently of the load-current copper. Equal 10-ohm input filters; differential 10 nF."
		(exclude_from_sim no)
		(at 15.24 248.92 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "0aec024f-ebec-5a1e-b78a-174000ca26e5")
	)
	(text "VBUS measures ENERGY_TAP, upstream of the eFuse and the load shunt. Current measures all downstream battery loads, not USB-only consumption."
		(exclude_from_sim no)
		(at 15.24 274.32 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "462ba6bd-183f-509c-9e4b-ea77060a2aa7")
	)
	(text "Current records electrical response. It does not prove that an initiator fired."
		(exclude_from_sim no)
		(at 15.24 287.02 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "958a5f56-25a8-510b-81d7-6c82d27ec2ef")
	)
	(text "What this does: Measures bulk battery current and input voltage, including when Croi runs without Foinse.\nConnects to: 01-power eFuse -> 5 mOhm shunt -> downstream loads. INA228 reports over the controlled I2C bus on 07. USB-only current does not pass through this shunt."
		(exclude_from_sim no)
		(at 15.24 27.94 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "9a8f20d4-602d-5862-aaa2-aa8120f1330d")
	)
	(text "COMMON BATTERY CURRENT / INPUT VOLTAGE"
		(exclude_from_sim no)
		(at 15.24 16.51 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "d3c1c165-19b9-5557-9b56-849b2f833e6e")
	)
	(text "INA228 address 0x40. A1/A0 low; ALERT unused. Optional I2C failure must not block flight."
		(exclude_from_sim no)
		(at 15.24 261.62 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "fa1ccc7c-44d9-5560-ae2d-8ae91662f6fd")
	)
