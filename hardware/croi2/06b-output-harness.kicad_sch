  (text "What this does: Defines the physical connector contacts for three energetic loads and three servos.\nConnects to: Three channel sheets -> J6601. Servo power/PWM on 06d -> J6602. Both wires of each energetic load return here; LOW is a switched return, not ground."
    (at 15.24 27.94 0.0)
    (effects
      (font
        (size 1.4 1.4))
      (justify left top))
    (uuid "c3257751-1afd-53a2-8a19-774764a2f79e")))
