	)
	(text "What this does: Shows the two switched sides for the staging channel: PE12 through the latch AND gate drives the high side, PD14 the low side.\nConnects to: STAGING_ARMED_VBAT (06a), STAGE_ELIGIBLE (06-outputs) and the flight MCU -> J6601 load pair on 06b; current report -> 06c. Energy link remains DNP: do not connect an initiator."
		(exclude_from_sim no)
		(at 15.24 27.94 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "d033265a-1710-5967-b2b2-55e157fc0b1d")
	)
	(text "Igniter values open: energy link R6510 stays DNP. R6514 1.24k sets the switch limit near 2.0 A; pulse length is set in firmware (D-6.2)."
		(exclude_from_sim no)
		(at 15.24 411.48 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left)
		)
		(uuid "d3efcf14-4e29-5379-b55f-8960565d9973")
	)
