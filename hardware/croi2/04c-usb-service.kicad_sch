  (text "Both CC pins have their own 5.1k sink resistor. USB2 A/B data contacts join at the connector; SBU contacts are unused."
    (at 15.24 248.92 0)
    (effects
      (font
        (size 1.2 1.2))
      (justify left))
    (uuid "4b0f08dd-0e31-5dab-928d-3c776f43485e"))
  (text "U4401 limit fixed by R4403 60.4k: 387-491 mA from attach (D-6.5); strict hosts may need a powered hub.\nUSB_CONFIG_OK keeps only its R4404 pull-down on this sheet."
    (at 15.24 259.08 0)
    (effects
      (font
        (size 1.2 1.2))
      (justify left))
    (uuid "13e03ae0-caf7-5029-9494-f405405b569e"))
  (text "Enumeration, configured-current policy, cable ESD and USB signal integrity still require first-PCBA tests. Native connectivity is unchanged."
    (at 15.24 269.24 0)
    (effects
      (font
        (size 1.2 1.2))
      (justify left))
    (uuid "01454fed-d733-5497-81f8-2f877927eaa5"))
