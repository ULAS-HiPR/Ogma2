  (text "What this does: Switches the shared battery supply to three servos and passes their PWM commands without back-powering the servos.\nConnects to: Flight enable/PWM/reset -> protected raw-2S output and three PWM lines -> J6602 on 06b. The small 3.3 V regulator powers the signal buffer, not the motors."
    (at 15.24 27.94 0.0)
    (effects
      (font
        (size 1.4 1.4))
      (justify left top))
    (uuid "828695d5-7dc2-5b50-a804-ecfdad26e22d")))
