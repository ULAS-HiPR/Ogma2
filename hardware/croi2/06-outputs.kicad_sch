	(text "A low arm sense is not proof that the physical energy break is open."
		(exclude_from_sim no)
		(at 15.24 330.2 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left)
		)
		(uuid "023a1c82-d17e-5b9f-9769-7c6839027fcd")
	)
	(text "1  NEW-FLIGHT EDGE / RESET-TO-INHIBIT LATCH"
		(exclude_from_sim no)
		(at 15.24 58.42 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left)
		)
		(uuid "152e9dd5-2ffc-565d-88a5-87f848cda0df")
	)
	(text "What this does: Holds the staging channel inhibited after any flight reset or power-up, until the flight MCU clocks the latch with staging disarmed (D-7.2).\nConnects to: FLIGHT_NRST, PD15 request and STAGE_ARM_INVALID (06a) -> STAGE_ELIGIBLE to 06pyro3; STAGE_INHIBIT_LATCHED -> PE14. This logic does not replace a physical energy disconnect."
		(exclude_from_sim no)
		(at 15.24 27.94 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "16af8c03-a3c5-56b5-8efa-1a5f13138b6d")
	)
	(text "D = STAGE_ARM_INVALID (U6103 OUTB, 06a): the latch can only be set while staging is disarmed."
		(exclude_from_sim no)
		(at 30.48 187.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2f6e02e7-00c5-5bf7-be5a-3d8985b577f6")
	)
	(text "OUTPUT AUTHORITY / STAGING RESET LATCH"
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "363c6d1d-3bff-511d-93d7-71cd60fc4892")
	)
	(text "All internal/debug/software reset classes must clear this latch; target NRST proof remains open."
		(exclude_from_sim no)
		(at 15.24 335.28 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left)
		)
		(uuid "3c43f12b-02f1-563e-b310-47d39ad3f12f")
	)
	(text "Q-bar -> R6005 1k -> PE14. Arm feeds and arm sense: 06a. Channel 3 fires only through U6502 (PYRO3_FIRE AND STAGE_ELIGIBLE), 06pyro3."
		(exclude_from_sim no)
		(at 15.24 325.12 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left)
		)
		(uuid "5877b1c8-c376-54db-a6ea-9ee95253a742")
	)
	(text "CLOCK is the request edge. D qualifies the edge; do not gate the clock."
		(exclude_from_sim no)
		(at 30.48 182.88 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left)
		)
		(uuid "642f253c-992d-5d40-b908-0fcbcfaf9550")
	)
	(text "CLK is the request edge directly. Disarm qualifies D, never gates CLK. Q-bar = inhibited."
		(exclude_from_sim no)
		(at 15.24 320.04 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left)
		)
		(uuid "93d4a865-22c5-572f-a555-09849bafef9f")
	)
