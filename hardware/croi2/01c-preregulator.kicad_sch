	(text "Integrated switching module: no external inductor or bootstrap parts. 800 kHz starting point; nominal 4.0 V output."
		(exclude_from_sim no)
		(at 373.38 227.33 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify right)
		)
		(uuid "1c0dbfc6-b2ce-5794-b262-688ccd9ad223")
	)
	(text "What this does: Efficiently reduces the selected input to about 4 V before the quieter 3.3 V regulators.\nConnects to: 01a source selector -> 01d held flight input, 01comms-limit and 01optional-limit. This is a shared supply, not redundant power."
		(exclude_from_sim no)
		(at 373.38 27.94 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify right top)
		)
		(uuid "1ff2c67b-aaef-56bf-aa06-14bbbb38a154")
	)
	(text "Feedback senses the real output node. Minimum USB input/dropout, effective output capacitance and conducted/radiated noise still require tests."
		(exclude_from_sim no)
		(at 373.38 234.95 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify right)
		)
		(uuid "5bd1aa2d-db67-595f-ae08-7c9953d0e84c")
	)
	(text "4.0 V PREREGULATOR / INTEGRATED INDUCTOR"
		(exclude_from_sim no)
		(at 373.38 15.24 0)
