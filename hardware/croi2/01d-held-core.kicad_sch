  (text "What this does: Reserves local energy for the flight MCU during a brief input dip, and blocks that energy flowing back upstream.\nConnects to: 01c 4 V supply, enabled by its own level (01b) -> 01flight-ldo. Hold-up time is not proved."
    (at 15.24 27.94 0.0)
    (effects
      (font
        (size 1.4 1.4))
      (justify left top))
    (uuid "80c53310-fc5a-52f0-bd1a-5642aaffce29")))
